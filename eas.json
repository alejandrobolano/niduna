{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
