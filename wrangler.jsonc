{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "niduna-dev",
  "compatibility_date": "2026-07-26",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "development": {
      "name": "niduna-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "dev.niduna.com",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "name": "niduna",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "niduna.com",
          "custom_domain": true
        }
      ]
    }
  }
}
