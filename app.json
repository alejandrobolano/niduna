{
  "expo": {
    "name": "Niduna",
    "slug": "niduna",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "niduna",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.niduna.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.niduna.app",
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Niduna necesita acceso a tus fotos para añadir imágenes privadas del bebé y compartir historias con tu familia.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Niduna necesita acceso a tus contactos para guardar únicamente los contactos que elijas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6F61",
          "defaultChannel": "care-updates",
          "icon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8E8",
          "dark": {
            "backgroundColor": "#0F1428",
            "image": "./assets/images/splash-icon.png"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "NidunaCareWidget",
              "displayName": "Relevo de Niduna",
              "description": "Consulta los últimos cuidados del bebé de un vistazo.",
              "ios": {
                "supportedFamilies": ["systemMedium"]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "NidunaCareWidget",
              "label": "Relevo de Niduna",
              "description": "Última alimentación, pañal y sueño del bebé.",
              "minWidth": "320dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/with-android-work-manager-resolution"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6573326c-c393-4dec-bbdd-36b15aeffe12"
      }
    }
  }
}
